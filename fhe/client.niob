use shared::*

scheme CKKS {
    security: 128-classic
    key_dist: uniform_ternary
    scaling: flexible_auto
    precision: 42
    first_mod: 57
    depth: 2
}

requires { add, mul }

// Key generation is hand-rolled in keygen.cpp, not emitted from the DSL. The
// DSL's keygen unconditionally calls EvalSumKeyGen, which at N=65536 produces a
// full slot-rotation key set (~150 MB in rk.bin) for cross-slot summation. This
// circuit is entirely per-slot (one opportunity per SIMD slot; no rotations or
// sums), so it needs none of those keys, and hand-rolling keygen keeps them out
// of both the on-disk keys and the Fog upload. keygen.cpp matches this scheme
// block exactly, so the context stays consistent with the stages below.

// The local client has already converted the human-friendly brief to a
// fixed-length vector and replicated it across all SIMD slots.
@client @stage("encrypt_fingerprint")
fn encrypt_fingerprint(inst: Instance)
    -> reads(CryptoParams), writes(EncryptedFingerprint)
{
    let params = load(CryptoParams, from: keydir(inst))
    let matrix = load_matrix<f64>(fingerprint_file(inst), inst.n_features)
    return EncryptedFingerprint {
        features: for feature in 0..inst.n_features {
            let column: vec<f64> = matrix[0..inst.n_slots, feature]
            encrypt(params.public_key, column)
        }
    }
}

@client @stage("encrypt_entity_query")
fn encrypt_entity_query(inst: Instance)
    -> reads(CryptoParams), writes(EncryptedEntityQuery)
{
    let params = load(CryptoParams, from: keydir(inst))
    let matrix = load_matrix<f64>(entity_query_file(inst), inst.n_entity_features)
    return EncryptedEntityQuery {
        features: for feature in 0..inst.n_entity_features {
            let column: vec<f64> = matrix[0..inst.n_slots, feature]
            encrypt(params.public_key, column)
        }
    }
}

@client @stage("decrypt_scores")
fn decrypt_scores(inst: Instance)
    -> reads(EncryptedMatchScores), writes_plaintext(iodir(inst) / "scores.bin")
{
    let sk = load_secret_key(keydir(inst) / "sk.bin")
    let encrypted = load(EncryptedMatchScores, from: encdir(inst))
    return decrypt(sk, encrypted.scores)
}

